@model MedicalSupplies.Mvc.ViewModels.SupplySearchViewModel

@{
    ViewData["Title"] = "Search Supplies";
}

<div class="page-header">
    <div>
        <h2 class="page-title">Tìm kiếm Vật tư y tế</h2>
        <p class="page-description">Form GET dùng Query String để tìm kiếm sản phẩm.</p>
    </div>
    <a class="btn btn-light" asp-controller="Supplies" asp-action="Index">Quay lại danh sách</a>
</div>

<div class="row">
    <!-- Cột chứa Form tìm kiếm (Bên trái) -->
    <div class="col-md-4">
        <form class="p-4 bg-white shadow-sm rounded-3 border" asp-controller="Supplies" asp-action="Search" method="get">
            <div class="mb-3">
                <label asp-for="Keyword" class="form-label fw-bold">Từ khóa (Tên/SKU)</label>
                <input asp-for="Keyword" class="form-control" placeholder="VD: Khẩu trang, MED-..." />
            </div>

            <div class="mb-3">
                <label asp-for="Category" class="form-label fw-bold">Nhóm phân loại</label>
                <input asp-for="Category" class="form-control" placeholder="VD: Bảo hộ cá nhân" />
            </div>

            <div class="mb-3">
                <label asp-for="Supplier" class="form-label fw-bold">Nhà cung cấp</label>
                <input asp-for="Supplier" class="form-control" placeholder="VD: 3M Medical" />
            </div>

            <div class="row mb-4">
                <div class="col-6">
                    <label asp-for="MinPrice" class="form-label fw-bold small">Giá từ (VND)</label>
                    <input asp-for="MinPrice" class="form-control" placeholder="0" />
                </div>
                <div class="col-6">
                    <label asp-for="MaxPrice" class="form-label fw-bold small">Giá đến (VND)</label>
                    <input asp-for="MaxPrice" class="form-control" placeholder="500000" />
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">Tìm kiếm</button>
                <a asp-action="Search" class="btn btn-secondary w-100">Reset</a>
            </div>
        </form>
    </div>

    <!-- Cột chứa kết quả (Bên phải) -->
    <div class="col-md-8">
        <div class="p-4 bg-white shadow-sm rounded-3 border min-vh-100">
            <h4 class="mb-4 fw-bold">Kết quả tìm kiếm</h4>
            
            <!-- GỌI PARTIAL VIEW KẾT QUẢ TÌM KIẾM Ở ĐÂY -->
            <partial name="_SupplySearchResult" model="Model.Results" />

        </div>
    </div>
</div>