@model List<SupplyListItemViewModel>  
  
@{  
 ViewData["Title"] = "Supplies Catalog";  
 var totalItems = Model.Count;  
}  
  
<div class="page-header">  
 <div>  
 <h2 class="page-title">Supplies Catalog</h2>  
 <p class="page-description">  
 Đây là trang danh sách vật tư y tế của cơ sở.  
 </p>  
 </div>  
  
 <div>  
 <a class="btn btn-primary" href="/Supplies/Stats">  
 Xem thống kê tồn kho  
 </a>  
 </div>  
</div>  
  
<div class="info-panel">  
 <strong>Tổng số loại vật tư:</strong> @totalItems  
</div>  
  
@if (Model.Count == 0)  
{  
 <p>Chưa có vật tư nào trong hệ thống.</p>  
}  
else  
{  
 <table class="table table-bordered table-striped align-middle">  
 <thead>  
 <tr>  
 <th>SKU</th>  
 <th>Tên vật tư</th>  
 <th>Nhóm</th>  
 <th>Giá bán</th>  
 <th>Số lượng</th>  
 <th>Giá trị tồn kho</th>  
 <th>Trạng thái</th>  
 <th>Chi tiết</th>  
 </tr>  
 </thead>  
  
 <tbody>  
 @foreach (var item in Model)  
 {  
 <tr>  
 <td>@item.Sku</td>  
 <td>@item.Name</td>  
 <td>@item.Category</td>  
 <td>@item.PriceText</td>  
 <td>@item.Quantity</td>  
 <td>@item.InventoryValueText</td>  
 <td>  
 <span class="@item.StockStatusClass">  
 @item.StockStatus  
 </span>  
 </td>  
 <td>  
 <a href="/Supplies/Detail/@item.Id" class="btn btn-sm btn-link">Xem</a>  
 </td>  
 </tr>  
 }  
 </tbody>  
 </table>
}  
  
<p class="mt-4">  
 <a class="btn btn-light" href="/">  
 Quay lại trang chủ  
 </a>  
</p>