@{  
    ViewData["Title"] = "Trang chủ";  
}  
  
<div class="lab-hero">  
    <h1>Hệ Thống Quản Lý Vật Tư Y Tế</h1>  
    <p>  
        Phiên bản nâng cấp - ASP.NET Core MVC Lab03<br />  
        Áp dụng Layout, Partial View, Tag Helpers, Form GET/POST và Validation.
    </p>  
</div>  
  
<div class="info-panel">  
    <h4 class="mb-3">Mục tiêu đạt được trong Lab 03:</h4>  
    <ul class="flow-list">  
        <li>🚀 <strong>Layout & Partial View:</strong> Tái sử dụng giao diện, chuyển đổi danh sách từ dạng Bảng sang Grid Card.</li>  
        <li>🔍 <strong>Tìm kiếm (GET):</strong> Form tìm kiếm vật tư kết hợp Query String và Model Binding.</li>  
        <li>📝 <strong>Thêm mới (POST):</strong> Form nhập liệu an toàn với Tag Helpers và Data Annotations Validation.</li>  
        <li>✅ <strong>Trải nghiệm UX:</strong> Hiển thị thông báo bằng TempData và áp dụng PRG Pattern tránh submit nhầm.</li>  
    </ul>  
</div>  
  
<h3 class="text-center mt-5 mb-4 fw-bold">Khám phá các chức năng</h3>  
  
<div class="row text-center g-4 justify-content-center mb-5">  
    <!-- Card Danh sách -->
    <div class="col-md-3">
        <div class="p-4 bg-white border rounded-4 shadow-sm h-100 d-flex flex-column transition-hover">
            <div class="display-5 mb-3">📦</div>
            <h5 class="fw-bold">Danh sách</h5>
            <p class="text-muted small mb-4">Xem danh mục vật tư y tế hiện có trong kho.</p>
            <a class="btn btn-primary mt-auto" asp-controller="Supplies" asp-action="Index">Xem danh sách</a>
        </div>
    </div>

    <!-- Card Tìm kiếm -->
    <div class="col-md-3">
        <div class="p-4 bg-white border rounded-4 shadow-sm h-100 d-flex flex-column transition-hover">
            <div class="display-5 mb-3">🔍</div>
            <h5 class="fw-bold">Tìm kiếm</h5>
            <p class="text-muted small mb-4">Tra cứu vật tư theo từ khóa, mức giá, phân loại.</p>
            <a class="btn btn-outline-primary mt-auto" asp-controller="Supplies" asp-action="Search">Mở tìm kiếm</a>
        </div>
    </div>

    <!-- Card Thêm mới -->
    <div class="col-md-3">
        <div class="p-4 bg-white border rounded-4 shadow-sm h-100 d-flex flex-column transition-hover">
            <div class="display-5 mb-3">➕</div>
            <h5 class="fw-bold">Thêm mới</h5>
            <p class="text-muted small mb-4">Khai báo thông tin vật tư y tế mới vào hệ thống.</p>
            <a class="btn btn-success mt-auto" asp-controller="Supplies" asp-action="Create">Thêm vật tư</a>
        </div>
    </div>

    <!-- Card Thống kê -->
    <div class="col-md-3">
        <div class="p-4 bg-white border rounded-4 shadow-sm h-100 d-flex flex-column transition-hover">
            <div class="display-5 mb-3">📊</div>
            <h5 class="fw-bold">Thống kê</h5>
            <p class="text-muted small mb-4">Báo cáo tổng quan tình hình giá trị và tồn kho.</p>
            <a class="btn btn-info text-white mt-auto" asp-controller="Supplies" asp-action="Stats">Xem báo cáo</a>
        </div>
    </div>
</div>